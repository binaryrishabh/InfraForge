{
  "name": "infraforge",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/web",
    "apps/backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "pwsh ./dev.ps1",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "bun run check:boundaries && turbo run lint",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --filter=@infraforge/backend",
    "test:integration:local": "pwsh ./scripts/test-integration.ps1",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "test:tooling": "bun test scripts/tests",
    "audit": "bun audit --json"
  },
  "devDependencies": {
    "turbo": "2.11.6",
    "ignore": "7.0.6",
    "content-type": "2.0.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@babel/parser": "7.29.8",
    "@eslint/plugin-kit": "0.7.2",
    "@jridgewell/sourcemap-codec": "1.5.5",
    "@napi-rs/wasm-runtime": "1.2.2",
    "@oxc-project/types": "0.142.0",
    "@rolldown/binding-android-arm64": "1.2.2",
    "@rolldown/binding-darwin-arm64": "1.2.2",
    "@rolldown/binding-darwin-x64": "1.2.2",
    "@rolldown/binding-freebsd-x64": "1.2.2",
    "@rolldown/binding-linux-arm-gnueabihf": "1.2.2",
    "@rolldown/binding-linux-arm64-gnu": "1.2.2",
    "@rolldown/binding-linux-arm64-musl": "1.2.2",
    "@rolldown/binding-linux-ppc64-gnu": "1.2.2",
    "@rolldown/binding-linux-s390x-gnu": "1.2.2",
    "@rolldown/binding-linux-x64-gnu": "1.2.2",
    "@rolldown/binding-linux-x64-musl": "1.2.2",
    "@rolldown/binding-openharmony-arm64": "1.2.2",
    "@rolldown/binding-win32-arm64-msvc": "1.2.2",
    "@rolldown/binding-win32-x64-msvc": "1.2.2",
    "@tybys/wasm-util": "0.10.3",
    "@types/lodash": "4.17.24",
    "@types/pg": "8.20.1",
    "baseline-browser-mapping": "2.11.12",
    "brace-expansion": "5.0.12",
    "browserslist": "4.28.7",
    "caniuse-lite": "1.0.30001806",
    "deepmerge-ts": "8.0.0",
    "electron-to-chromium": "1.5.399",
    "enhanced-resolve": "5.24.5",
    "fast-uri": "3.1.8",
    "follow-redirects": "1.16.0",
    "lru.min": "1.1.4",
    "nanoid": "3.3.18",
    "mysql2": "3.23.1",
    "negotiator": "1.0.0",
    "node-releases": "2.0.51",
    "ohash": "2.0.11",
    "pg-cloudflare": "1.4.0",
    "pg-connection-string": "2.14.0",
    "pg-protocol": "1.15.0",
    "picomatch": "4.0.5",
    "pkg-types": "2.3.1",
    "postcss": "8.5.25",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "rc9": "3.0.1",
    "readdirp": "5.0.0",
    "rolldown": "1.2.2",
    "source-map-js": "1.2.2",
    "update-browserslist-db": "1.2.3"
  }
}
