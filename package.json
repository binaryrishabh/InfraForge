{
  "name": "infraforge",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/web",
    "apps/backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "pwsh ./dev.ps1",
    "dev:setup": "pwsh ./dev.ps1 -SetupOnly",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc --noEmit -p scripts/release/tsconfig.json",
    "lint": "bun run check:boundaries && turbo run lint",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --filter=@infraforge/backend",
    "test:integration:local": "pwsh ./scripts/test-integration.ps1",
    "check:boundaries": "turbo run db:generate --filter=@infraforge/backend && bun scripts/check-boundaries.ts",
    "test:tooling": "bun test scripts/tests",
    "check:challenges": "bun --cwd apps/backend --no-env-file --no-install test tests/challengeAuthoring.test.ts tests/challenges.test.ts tests/experiment.test.ts tests/experimentEvidence.test.ts tests/faultCalibration.test.ts tests/cpuHeadroomCalibration.test.ts tests/postFaultObservation.test.ts",
    "check:reality": "bun --no-env-file scripts/reality/inventory.ts",
    "debug:model2": "bun --no-env-file packages/simulation/tests/model2Debug.ts",
    "debug:workload": "bun --no-env-file scripts/reality/workload-proof.ts",
    "check:calibration": "bun --no-env-file scripts/reality/workload-calibration.ts",
    "measure:workload": "bun --no-env-file scripts/reality/workload-calibration.ts --measure",
    "perf:workload": "bun --no-env-file scripts/reality/workload-performance.ts",
    "debug:compute": "bun --no-env-file scripts/reality/compute-proofs.ts",
    "check:compute": "bun --no-env-file scripts/reality/compute-calibration.ts",
    "measure:compute": "bun --no-env-file scripts/reality/measure-compute.ts",
    "perf:compute": "bun --no-env-file scripts/reality/compute-performance.ts",
    "debug:network": "bun --no-env-file scripts/reality/network-proofs.ts",
    "check:network": "bun --no-env-file scripts/reality/network-calibration.ts",
    "measure:network": "node scripts/reality/network-benchmark.mjs",
    "perf:network": "bun --no-env-file scripts/reality/network-performance.ts",
    "debug:data": "bun --no-env-file scripts/reality/data-proofs.ts",
    "check:data": "bun --no-env-file scripts/reality/data-calibration.ts",
    "measure:data": "node scripts/reality/data-benchmark.mjs",
    "perf:data": "bun --no-env-file scripts/reality/data-performance.ts",
    "debug:async": "bun --no-env-file scripts/reality/async-proofs.ts",
    "check:async": "bun --no-env-file scripts/reality/async-calibration.ts",
    "measure:async": "node scripts/reality/async-benchmark.mjs",
    "perf:async": "bun --no-env-file scripts/reality/async-performance.ts",
    "debug:systems": "bun --no-env-file scripts/reality/systems-proofs.ts",
    "check:systems": "bun --no-env-file scripts/reality/systems-calibration.ts",
    "measure:systems": "node scripts/reality/systems-benchmark.mjs",
    "perf:systems": "bun --no-env-file scripts/reality/systems-performance.ts",
    "check:shipping": "bun --no-env-file scripts/reality/shipping-inventory.ts",
    "check:model2-shipping": "bun --no-env-file scripts/reality/shipping-inventory.ts --ready",
    "audit": "bun audit --json",
    "debug:product": "bun --no-env-file scripts/reality/product-proofs.ts",
    "check:product": "bun --no-env-file scripts/reality/product-artifacts.ts",
    "sweep:product": "bun --no-env-file scripts/reality/product-proofs.ts --sweeps",
    "perf:product": "bun --no-env-file scripts/reality/product-performance.ts",
    "check:product-ui": "bun --no-env-file scripts/reality/shipping-inventory.ts --ui-ready",
    "check:model2-reality-shipping": "bun --no-env-file scripts/reality/shipping-inventory.ts --ready"
  },
  "devDependencies": {
    "turbo": "2.11.6",
    "ignore": "7.0.6",
    "content-type": "2.0.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@babel/parser": "7.29.8",
    "@eslint/plugin-kit": "0.7.2",
    "@jridgewell/sourcemap-codec": "1.5.5",
    "@napi-rs/wasm-runtime": "1.2.2",
    "@oxc-project/types": "0.142.0",
    "@rolldown/binding-android-arm64": "1.2.2",
    "@rolldown/binding-darwin-arm64": "1.2.2",
    "@rolldown/binding-darwin-x64": "1.2.2",
    "@rolldown/binding-freebsd-x64": "1.2.2",
    "@rolldown/binding-linux-arm-gnueabihf": "1.2.2",
    "@rolldown/binding-linux-arm64-gnu": "1.2.2",
    "@rolldown/binding-linux-arm64-musl": "1.2.2",
    "@rolldown/binding-linux-ppc64-gnu": "1.2.2",
    "@rolldown/binding-linux-s390x-gnu": "1.2.2",
    "@rolldown/binding-linux-x64-gnu": "1.2.2",
    "@rolldown/binding-linux-x64-musl": "1.2.2",
    "@rolldown/binding-openharmony-arm64": "1.2.2",
    "@rolldown/binding-win32-arm64-msvc": "1.2.2",
    "@rolldown/binding-win32-x64-msvc": "1.2.2",
    "@tybys/wasm-util": "0.10.3",
    "@types/lodash": "4.17.24",
    "@types/pg": "8.20.1",
    "baseline-browser-mapping": "2.11.12",
    "brace-expansion": "5.0.12",
    "browserslist": "4.28.7",
    "caniuse-lite": "1.0.30001806",
    "deepmerge-ts": "8.0.0",
    "electron-to-chromium": "1.5.399",
    "enhanced-resolve": "5.24.5",
    "fast-uri": "3.1.8",
    "follow-redirects": "1.16.0",
    "lru.min": "1.1.4",
    "nanoid": "3.3.18",
    "mysql2": "3.23.1",
    "negotiator": "1.0.0",
    "node-releases": "2.0.51",
    "ohash": "2.0.11",
    "pg-cloudflare": "1.4.0",
    "pg-connection-string": "2.14.0",
    "pg-protocol": "1.15.0",
    "picomatch": "4.0.5",
    "pkg-types": "2.3.1",
    "postcss": "8.5.25",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "rc9": "3.0.1",
    "readdirp": "5.0.0",
    "rolldown": "1.2.2",
    "source-map-js": "1.2.2",
    "update-browserslist-db": "1.2.3"
  }
}
