{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infraforge.invalid/contracts/postgresql-keyed-io-draft-1.json",
  "title": "Finite keyed IO proposal for slice 07b; not an executable engine input",
  "description": "Structural authoring contract only. Cross-field admission rules and service semantics are normative in finite-io-contract.md. This schema does not activate IO or accept arbitrary SQL.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "evidence", "devices", "buffers", "plans", "limits"],
  "properties": {
    "schema": { "const": "postgresql-keyed-io/draft-1" },
    "status": { "const": "proposal-not-executable" },
    "evidence": { "$ref": "#/$defs/evidence" },
    "devices": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "generation", "queueOperations", "queueBytes", "serviceConcurrency", "iops", "bytesPerSecond", "flushServiceUs", "policy"],
        "properties": {
          "id": { "$ref": "#/$defs/id" }, "generation": { "type": "integer", "minimum": 0 },
          "queueOperations": { "$ref": "#/$defs/count" }, "queueBytes": { "$ref": "#/$defs/bytes" },
          "serviceConcurrency": { "$ref": "#/$defs/count" },
          "iops": { "$ref": "#/$defs/iops" }, "bytesPerSecond": { "$ref": "#/$defs/rate" },
          "flushServiceUs": { "$ref": "#/$defs/us" },
          "policy": { "const": "fifo-max-operation-byte-service/1" }
        }
      }
    },
    "buffers": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["owner", "host", "device", "pageBytes", "capacityBytes", "initialPages", "policy"],
        "properties": {
          "owner": { "$ref": "#/$defs/id" }, "host": { "$ref": "#/$defs/id" }, "device": { "$ref": "#/$defs/id" },
          "pageBytes": { "$ref": "#/$defs/bytes" }, "capacityBytes": { "$ref": "#/$defs/bytes" },
          "initialPages": { "type": "array", "maxItems": 10000, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
          "policy": { "const": "declared-clean-page-lru/1" }
        }
      }
    },
    "plans": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "operation", "bufferOwner", "device", "orderedPages", "cpuUs", "walBytes", "walOperations", "commitAck", "backgroundWrites"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "operation": { "enum": ["point-read", "range-read", "independent-update", "hot-update"] },
          "bufferOwner": { "$ref": "#/$defs/id" }, "device": { "$ref": "#/$defs/id" },
          "orderedPages": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/id" } },
          "cpuUs": { "$ref": "#/$defs/cpu" }, "walBytes": { "$ref": "#/$defs/bytes" },
          "walOperations": { "$ref": "#/$defs/count" },
          "commitAck": { "enum": ["read-only", "logical-only", "declared-local-wal-flush"] },
          "backgroundWrites": { "enum": ["explicit-bounded-schedule", "excluded-unknown"] }
        }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxPages", "maxReceipts", "maxScheduledBackgroundOperations", "maxScheduledBackgroundBytes"],
      "properties": {
        "maxPages": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "maxReceipts": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "maxScheduledBackgroundOperations": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "maxScheduledBackgroundBytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "source", "revision", "domain", "label"],
      "properties": {
        "kind": { "enum": ["observed", "authored"] },
        "source": { "type": "string", "minLength": 1 }, "revision": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "label": { "enum": ["supported-logical", "assumption-only"] }
      }
    },
    "quantity": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["value", "unit", "evidence"], "properties": { "value": { "type": "number", "minimum": 0 }, "unit": { "type": "string" }, "evidence": { "$ref": "#/$defs/evidence" } } },
        { "type": "object", "additionalProperties": false, "required": ["value", "unit", "reason"], "properties": { "value": { "type": "null" }, "unit": { "type": "string" }, "reason": { "type": "string", "minLength": 1 } } }
      ]
    },
    "count": { "allOf": [{ "$ref": "#/$defs/quantity" }, { "properties": { "unit": { "const": "count" }, "value": { "type": ["integer", "null"] } } }] },
    "bytes": { "allOf": [{ "$ref": "#/$defs/quantity" }, { "properties": { "unit": { "const": "bytes" }, "value": { "type": ["integer", "null"] } } }] },
    "us": { "allOf": [{ "$ref": "#/$defs/quantity" }, { "properties": { "unit": { "const": "us" } } }] },
    "cpu": { "allOf": [{ "$ref": "#/$defs/quantity" }, { "properties": { "unit": { "const": "cpu-us" } } }] },
    "iops": { "allOf": [{ "$ref": "#/$defs/quantity" }, { "properties": { "unit": { "const": "operations/s" } } }] },
    "rate": { "allOf": [{ "$ref": "#/$defs/quantity" }, { "properties": { "unit": { "const": "bytes/s" } } }] }
  }
}
