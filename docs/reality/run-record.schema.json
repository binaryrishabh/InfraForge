{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "infraforge-run-record/1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "designId": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "engine": {
      "type": "object",
      "properties": {
        "lineage": {
          "type": "string",
          "enum": [
            "1",
            "2"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "lineage",
        "version",
        "source"
      ],
      "additionalProperties": false
    },
    "experiment": {
      "type": "object",
      "properties": {
        "inputSchema": {
          "type": [
            "string",
            "null"
          ]
        },
        "input": {},
        "horizonSeconds": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "inputSchema",
        "input",
        "horizonSeconds"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "reportSchema": {
          "type": "string"
        },
        "report": {},
        "unknown": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "reportSchema",
        "report",
        "unknown"
      ],
      "additionalProperties": false
    },
    "reference": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "engine": {
              "type": "string",
              "const": "1"
            },
            "store": {
              "type": "string",
              "const": "Deployment"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "engine",
            "store",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "engine": {
              "type": "string",
              "const": "2"
            },
            "store": {
              "type": "string",
              "enum": [
                "InternalModel2Run",
                "FirstStackRun"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "engine",
            "store",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "availability": {
      "type": "object",
      "properties": {
        "report": {
          "type": "string",
          "enum": [
            "readable",
            "partial",
            "unavailable"
          ]
        },
        "execution": {
          "type": "string",
          "enum": [
            "available",
            "execution-retired",
            "unavailable"
          ]
        },
        "replay": {
          "type": "string",
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "report",
        "execution",
        "replay",
        "reasons"
      ],
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "migrated-from"
        },
        "source": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "engine": {
                  "type": "string",
                  "const": "1"
                },
                "store": {
                  "type": "string",
                  "const": "Deployment"
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "engine",
                "store",
                "id"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "engine": {
                  "type": "string",
                  "const": "2"
                },
                "store": {
                  "type": "string",
                  "enum": [
                    "InternalModel2Run",
                    "FirstStackRun"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "engine",
                "store",
                "id"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "kind",
        "source"
      ],
      "additionalProperties": false
    },
    "learning": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "challenge",
            "lesson"
          ]
        },
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "prediction": {}
      },
      "required": [
        "kind",
        "profile"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "id",
    "designId",
    "status",
    "createdAt",
    "updatedAt",
    "engine",
    "experiment",
    "evidence"
  ],
  "additionalProperties": false
}
