{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infraforge-g1-summary/1",
  "title": "Immutable local semantic pilot summary",
  "type": "object",
  "required": ["schema", "scope", "timingPromotion", "evidenceLabel", "manifest", "sourceHashes", "producerHashes", "hostCpu", "images", "frozenDesign", "missingCounters", "demandCandidate", "failures", "windows", "artifacts"],
  "properties": {
    "schema": { "const": "infraforge-g1-summary/1" },
    "scope": { "const": "local-semantic-pilot-only" },
    "timingPromotion": { "const": false },
    "evidenceLabel": { "const": "assumption-only" },
    "sourceHashes": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "producerHashes": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "missingCounters": { "type": "object", "additionalProperties": { "type": "null" } },
    "failures": { "type": "array" },
    "demandCandidate": {
      "type": "object", "required": ["status", "subset", "threadCpuUs", "provider", "usableAsPublicProfile"],
      "properties": { "status": { "const": "unpromoted-local-input-only" }, "provider": { "type": "null" }, "usableAsPublicProfile": { "const": false }, "threadCpuUs": { "$ref": "#/$defs/distribution" } }
    },
    "windows": { "type": "array", "items": { "type": "object", "required": ["id", "operation", "rate", "split", "status", "observed", "warmup", "generator"],
      "properties": { "rate": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 }, "operation": { "enum": ["empty", "cpu", "point-read"] }, "split": { "enum": ["control", "discovery", "exploratory", "holdout"] }, "observed": { "$ref": "#/$defs/population" }, "warmup": { "$ref": "#/$defs/population" } } } },
    "artifacts": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "bytes", "sha256"], "properties": { "name": { "type": "string" }, "bytes": { "type": "integer", "minimum": 0 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": false } }
  },
  "$defs": {
    "distribution": { "oneOf": [{ "type": "null" }, { "type": "object", "required": ["count", "mean", "min", "p50", "p95", "p99", "max"], "properties": { "count": { "type": "integer", "minimum": 1 }, "mean": { "type": "number" }, "min": { "type": "number" }, "p50": { "type": "number" }, "p95": { "type": "number" }, "p99": { "type": "number" }, "max": { "type": "number" } }, "additionalProperties": false }] },
    "population": { "type": ["object", "null"], "required": ["offered", "sent", "outcomes", "serverSeen", "sentWithoutServer", "threadCpuUs", "poolWaitUs"], "properties": { "offered": { "type": "integer", "minimum": 0 }, "sent": { "type": "integer", "minimum": 0 }, "outcomes": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }, "threadCpuUs": { "$ref": "#/$defs/distribution" }, "poolWaitUs": { "$ref": "#/$defs/distribution" } } }
  }
}
