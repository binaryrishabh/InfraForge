{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "types": ["bun", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["../release.ts", "./*.ts", "../deploy/*.ts", "../load/*.ts", "../../ops/bootstrap/*.ts", "../tests/*.ts"]
}
