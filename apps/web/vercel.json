{
  "framework": "vite",
  "git": { "deploymentEnabled": { "main": false } },
  "installCommand": "cd ../.. && bun install --frozen-lockfile",
  "buildCommand": "cd ../.. && bun run build --filter=@infraforge/web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/(.*)", "destination": "/app" }
  ]
}
