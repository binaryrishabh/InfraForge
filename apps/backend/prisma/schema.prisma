generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Infrastructure {
  id                    String        @id           @default(uuid())
  userId                String
  ownerId               String?
  owner                 User?         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name                  String
  layout                Json
  challengeId           String?
  challengeVersion      Int?
  deployments           Deployment[] // One infrastructure has many deployments
  internalModel2Runs    InternalModel2Run[]
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  @@index([ownerId])
  @@index([ownerId, challengeId, challengeVersion])
}


model Deployment {
  id                    String           @id        @default(uuid())
  infrastructureId      String?
  infrastructure        Infrastructure?  @relation(fields: [infrastructureId], references: [id], onDelete: SetNull)
  ownerId               String?
  owner                 User?            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  runName               String?
  actionSequence        Int                         @default(0)
  actions               RunAction[]
  evidenceSamples       RunEvidenceSample[]
  terminalSnapshot      Json?
  sourceRunId           String?
  sourceRun             Deployment?      @relation("RunLineage", fields: [sourceRunId], references: [id], onDelete: SetNull)
  reruns                Deployment[]     @relation("RunLineage")
  rerunMode             String?
  autoStopAtSimulatedSeconds Int?
  challengeId           String?
  challengeVersion      Int?
  challengeSpecHash     String?
  challengePrediction   Json?
  predictionSubmittedAt DateTime?
  evaluationStopAtSimulatedSeconds Int?
  challengeExperiment              Json?
  improvementSourceId   String?
  improvementSource     Deployment?  @relation("ChallengeLearning", fields: [improvementSourceId], references: [id], onDelete: SetNull)
  improvements          Deployment[] @relation("ChallengeLearning")
  learningHypothesis    String?       @db.VarChar(400)
  learningIntent        String?
  status                String                      @default("pending") // pending, running, live, completed, failed, torn-down
  resourceCount         Int                         @default(0) // How many resources in this deployment
  stages                Json                        @default("[]") // Array of { timestamp, event, message }
  timeline              Json                        @default("[]") // Array of { timestamp, event, message }
  chaosEvents           Json                        @default("[]") // Chaos injection during deployment
  workloadProfile       Json?
  seed                  String?
  simulationState       Json?
  runInputs             Json?
  liveTopology          Json?
  topologyRevision      Int                         @default(0)
  runtimeActive         Boolean                     @default(false)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  @@index([ownerId, createdAt, id])
  @@index([infrastructureId])
  @@index([sourceRunId, createdAt, id])
  @@index([improvementSourceId, createdAt, id])
  @@index([ownerId, challengeId, createdAt])
  @@index([ownerId, challengeId, createdAt, id])
}

model RunAction {
  id                        String   @id @default(uuid())
  deploymentId              String
  deployment                Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  sequence                  Int
  kind                      String
  parameters                Json
  status                    String   @default("requested")
  requestedAt               DateTime @default(now())
  appliedAt                 DateTime?
  completedAt               DateTime?
  appliedSimulatedSeconds   Int?
  completedSimulatedSeconds Int?
  outcome                   Json?
  failureReason             String?  @db.VarChar(500)
  @@unique([deploymentId, sequence])
  @@index([deploymentId, status, sequence])
}

model RunEvidenceSample {
  deploymentId     String
  deployment       Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  simulatedSeconds Int
  sampledAt        DateTime @db.Timestamptz(3)
  payload          Json
  hash             String @db.VarChar(64)
  @@id([deploymentId, simulatedSeconds])
}

// Transactional delivery of deployment creation to BullMQ. Live controls use RunAction.
// ii. In chaos-injection 
model Outbox {
  id                    String           @id        @default(uuid())
  eventType             String
  payload               Json
  status                String                      @default("pending") // pending -> processing -> completed -> failed
  retries               Int                         @default(0) // retries already done
  maxRetries            Int                         @default(4) // max allowed retries 
  processedAt           DateTime?
  error                 String?
  createdAt             DateTime                    @default(now())
}

model User {
  id            String @id
  username      String? @unique @db.VarChar(30)
  name          String
  email         String @unique
  emailVerified Boolean @default(false)
  image         String?
  deletedAt     DateTime?
  emailTokens   AccountEmailToken[]
  mailOutbox    AccountMailOutbox[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sessions      Session[]
  accounts      Account[]
  designs       Infrastructure[]
  deployments   Deployment[]
  internalModel2Grant InternalModel2Grant?
  internalModel2Runs InternalModel2Run[]
  firstStackRuns FirstStackRun[]
  firstStackReplays FirstStackReplay[]
}

// Redemption ledger for Better Auth verification JWTs; never stores raw tokens.
model AccountMailOutbox {
  id          String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payload     String?
  status      String   @default("pending")
  attempts    Int      @default(0)
  retrySafe   Boolean
  availableAt DateTime @default(now())
  expiresAt   DateTime
  @@index([availableAt])
  @@index([userId])
  @@index([expiresAt])
}

model AccountEmailToken {
  hash String @id @db.VarChar(64)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt DateTime?
  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id        String @id
  token     String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id                    String @id
  accountId             String
  providerId            String
  userId                String
  user                  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@index([userId])
  @@unique([providerId, accountId])
}

model Verification {
  id         String @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}

model InternalModel2Grant {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason String @db.VarChar(400)
  scope String @default("operator") @db.VarChar(16)
  grantedAt DateTime @default(now()) @db.Timestamptz(3)
}

model InternalModel2Run {
  id String @id
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  infrastructureId String?
  infrastructure Infrastructure? @relation(fields: [infrastructureId], references: [id], onDelete: SetNull)
  idempotencyKey String @db.VarChar(80)
  requestHash String @db.VarChar(64)
  input Json
  inputHash String @db.VarChar(64)
  status String @default("queued")
  token String?
  sequence Int @default(0)
  throughUs Int @default(0)
  evidence Json?
  cancelRequested Boolean @default(false)
  reason String? @db.VarChar(500)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  lesson InternalModel2LessonRun?
  @@unique([ownerId, idempotencyKey])
  @@index([status, createdAt])
}

model InternalModel2LessonRun {
  runId String @id
  run InternalModel2Run @relation(fields: [runId], references: [id], onDelete: Cascade)
  policy Json
  receipt Json?
}

// Immutable browser submission; verification state lives in a separate work row.
model FirstStackRun {
  id String @id
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  idempotencyKey String @db.VarChar(80)
  requestHash String @db.VarChar(64)
  purpose String
  engine Json
  input String
  inputHash String @db.VarChar(64)
  lock Json
  seed String @db.VarChar(256)
  workload Json
  envelope Json
  lineage Json
  browserCut Json
  inputBytes Int
  reservedBytes Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  work FirstStackWork?
  result FirstStackResult?
  cuts FirstStackCut[]
  outbox FirstStackOutbox?
  replays FirstStackReplay[]
  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, createdAt])
}

model FirstStackWork {
  runId String @id
  run FirstStackRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  status String @default("queued")
  token String? @unique
  daemon String? @db.VarChar(64)
  cancelRequested Boolean @default(false)
  authorized Boolean @default(true)
  captureBytes Int @default(0)
  @@index([status])
}

model FirstStackCut {
  runId String
  run FirstStackRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  sequence Int
  body Json
  @@id([runId, sequence])
}

model FirstStackResult {
  runId String @id
  run FirstStackRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  body Json
  hash String @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model FirstStackOutbox {
  runId String @id
  run FirstStackRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  delivered Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model FirstStackReplay {
  id String @id
  runId String
  run FirstStackRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  fingerprint String @db.VarChar(64)
  status String @default("queued")
  delivered Boolean @default(false)
  cancelled Boolean @default(false)
  daemon String? @db.VarChar(64)
  result Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([status])
}
