generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Infrastructure {
  id                    String        @id           @default(uuid())
  userId                String
  ownerId               String?
  owner                 User?         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name                  String
  layout                Json
  challengeId           String?
  challengeVersion      Int?
  deployments           Deployment[] // One infrastructure has many deployments
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  @@index([ownerId])
  @@index([ownerId, challengeId, challengeVersion])
}


model Deployment {
  id                    String           @id        @default(uuid())
  infrastructureId      String?
  infrastructure        Infrastructure?  @relation(fields: [infrastructureId], references: [id], onDelete: SetNull)
  ownerId               String?
  owner                 User?            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  runName               String?
  actionSequence        Int                         @default(0)
  actions               RunAction[]
  terminalSnapshot      Json?
  sourceRunId           String?
  sourceRun             Deployment?      @relation("RunLineage", fields: [sourceRunId], references: [id], onDelete: SetNull)
  reruns                Deployment[]     @relation("RunLineage")
  rerunMode             String?
  autoStopAtSimulatedSeconds Int?
  challengeId           String?
  challengeVersion      Int?
  challengeSpecHash     String?
  challengePrediction   Json?
  predictionSubmittedAt DateTime?
  evaluationStopAtSimulatedSeconds Int?
  challengeExperiment              Json?
  status                String                      @default("pending") // pending, running, live, completed, failed, torn-down
  resourceCount         Int                         @default(0) // How many resources in this deployment
  stages                Json                        @default("[]") // Array of { timestamp, event, message }
  timeline              Json                        @default("[]") // Array of { timestamp, event, message }
  chaosEvents           Json                        @default("[]") // Chaos injection during deployment
  workloadProfile       Json?
  seed                  String?
  simulationState       Json?
  runInputs             Json?
  liveTopology          Json?
  topologyRevision      Int                         @default(0)
  runtimeActive         Boolean                     @default(false)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  @@index([ownerId, createdAt, id])
  @@index([infrastructureId])
  @@index([sourceRunId, createdAt, id])
  @@index([ownerId, challengeId, createdAt])
}

model RunAction {
  id                        String   @id @default(uuid())
  deploymentId              String
  deployment                Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  sequence                  Int
  kind                      String
  parameters                Json
  status                    String   @default("requested")
  requestedAt               DateTime @default(now())
  appliedAt                 DateTime?
  completedAt               DateTime?
  appliedSimulatedSeconds   Int?
  completedSimulatedSeconds Int?
  outcome                   Json?
  failureReason             String?  @db.VarChar(500)
  @@unique([deploymentId, sequence])
  @@index([deploymentId, status, sequence])
}

// Transactional delivery of deployment creation to BullMQ. Live controls use RunAction.
// ii. In chaos-injection 
model Outbox {
  id                    String           @id        @default(uuid())
  eventType             String
  payload               Json
  status                String                      @default("pending") // pending -> processing -> completed -> failed
  retries               Int                         @default(0) // retries already done
  maxRetries            Int                         @default(4) // max allowed retries 
  processedAt           DateTime?
  error                 String?
  createdAt             DateTime                    @default(now())
}

model User {
  id            String @id
  name          String
  email         String @unique
  emailVerified Boolean @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sessions      Session[]
  accounts      Account[]
  designs       Infrastructure[]
  deployments   Deployment[]
}

model Session {
  id        String @id
  token     String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id                    String @id
  accountId             String
  providerId            String
  userId                String
  user                  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@index([userId])
  @@unique([providerId, accountId])
}

model Verification {
  id         String @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}
