{
  "schema": "infraforge-scored-challenge/2",
  "id": "small-paste-api",
  "version": "2",
  "brief": {
    "title": "Small paste: return bounded text through finite links",
    "description": "People opening a small shared paste need its prepared 4 KiB text record. Serve the recorded requests through finite links while one app is unavailable. A text response consumes directed link capacity as well as application time; a queue cannot create bandwidth. Choose each app's cores, workers and queue. The private assessment checks delivery, errors, completed-request latency and fault survival. Fault survival uses delivered caller outcomes during the outage, not a health label. All offers are in [10000,70000) us; observe terminals through 100000 us. Hidden variants change burst shape, keys and failed app within the stated domain. Timing is assumption-only. Supported subtotal and full cost are Unknown.",
    "exclusions": [
      "Saving new text or generated identifiers",
      "expiry, access control and private pastes",
      "blob storage, large files or CDN delivery",
      "cache and autoscaling (later versions)",
      "post-fault recovery scoring",
      "calibrated cloud timing and complete resident memory",
      "supported cost subtotal and full cost"
    ],
    "support": {
      "counts": "supported-logical",
      "timing": "assumption-only"
    }
  },
  "constraints": {
    "topology": "fixed load balancer, two application processes and one relational DB; no cache",
    "editable": [
      "compute cores",
      "compute workers",
      "compute queue",
      "matching host cores"
    ],
    "cores": {
      "min": 1,
      "max": 4
    },
    "workers": {
      "min": 1,
      "max": 32
    },
    "queue": {
      "min": 0,
      "max": 64
    },
    "domain": "24..32 fetch-text calls; 1 recorded keys per call; 0..1000 us within-wave spacing; one app crash at 3000..6000 us for 68000..74000 us, recovery 3000..6000 us; all offers in [10000,70000) us, terminals through 100000 us. Synthetic assumptions only."
  },
