{
  "schema": "infraforge-scored-challenge/1",
  "id": "url-redirect",
  "version": "1",
  "brief": {
    "title": "URL shortener: keep redirects working",
    "description": "People following a shared link need a quick lookup even while an application process is unavailable. Resolve preassigned short IDs from the relational database. Keep spare application capacity for a popular link when one app fails. Choose each app's cores, workers and queue. Required goals on every held-out outage cohort: deliver at least 90% of offered requests, errors at most 10%, completed-request p95 at most 6000 us (20 completions required). Fault survival uses delivered caller outcomes during the outage, not a health label. All offers are in [10000,70000) us; observe terminals through 100000 us. Hidden variants change burst shape, keys and failed app within the stated domain. Timing is assumption-only. Supported subtotal and full cost are Unknown.",
    "exclusions": [
      "ID allocation and collision correctness",
      "expiry and abuse protection",
      "global Bitly or multi-region availability",
      "cache and autoscaling (later versions)",
      "post-fault recovery scoring",
      "calibrated cloud timing and complete resident memory",
      "supported cost subtotal and full cost"
    ],
    "support": {
      "counts": "supported-logical",
      "timing": "assumption-only"
    }
  },
  "constraints": {
    "topology": "fixed load balancer, two application processes and one relational DB; no cache",
    "editable": [
      "compute cores",
      "compute workers",
      "compute queue",
      "matching host cores"
    ],
    "cores": {
      "min": 1,
      "max": 4
    },
    "workers": {
      "min": 1,
      "max": 32
    },
    "queue": {
      "min": 0,
      "max": 64
    },
    "domain": "24..32 redirect calls; 1 recorded keys per call; 0..1000 us within-wave spacing; one app crash at 3000..6000 us for 68000..74000 us, recovery 3000..6000 us; all offers in [10000,70000) us, terminals through 100000 us. Synthetic assumptions only."
  },
