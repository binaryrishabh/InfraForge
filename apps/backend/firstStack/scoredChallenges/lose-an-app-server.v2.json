  "schema": "infraforge-scored-challenge/2",
  "id": "lose-an-app-server",
  "version": "2",
  "brief": {
    "title": "Keep redirect lookups working when an app server fails",
    "description": "Serve finite preassigned redirect keys through a load balancer, two application processes and one relational database. One app crashes. Meet the caller goals across hidden within-domain workload variations.",
    "exclusions": [
      "ID generation",
      "global availability",
      "calibrated cloud timing",
      "full cost"
    ],
    "support": {
      "counts": "supported-logical",
      "timing": "assumption-only"
    }
  },
  "constraints": {
    "topology": "fixed two-app redirect stack",
    "editable": [
      "compute cores",
      "compute workers",
      "compute queue",
      "matching host cores"
    ],
    "cores": {
      "min": 1,
      "max": 4
    },
    "workers": {
      "min": 1,
      "max": 32
    },
    "queue": {
      "min": 0,
      "max": 64
    },
    "domain": "24..32 redirect requests, 0..1000 us interarrival, either app lost from 5000 through 80000 us; all offers in 10000..70000 us"
  },
