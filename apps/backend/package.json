{
  "name": "@infraforge/backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch run index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "bun --no-env-file --no-install run --bun prisma generate --config prisma.config.ts",
    "db:migrate": "bun --no-env-file --no-install run --bun prisma migrate deploy --config prisma.config.ts",
    "dev:api": "bun --watch run index.ts",
    "dev:worker": "bun --watch run worker.ts",
    "dev:ws": "bun --watch run ws-server.ts",
    "test:integration": "bun --no-env-file --no-install test tests/integration"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "@types/node": "26.1.2"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.7",
    "@infraforge/catalog": "workspace:*",
    "@infraforge/domain": "workspace:*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "better-auth": "1.7.7",
    "bullmq": "6.0.8",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "http": "0.0.1-security",
    "ioredis": "6.0.0",
    "pg": "8.22.0",
    "prisma": "7.9.1",
    "redis": "6.2.0",
    "uuid": "14.0.1",
    "ws": "8.21.2",
    "zod": "4.4.3",
    "@infraforge/contracts": "workspace:*",
    "@infraforge/simulation": "workspace:*"
  }
}
