generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Infrastructure {
  id                    String        @id           @default(uuid())
  userId                String
  ownerId               String?
  owner                 User?         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name                  String
  layout                Json
  deployments           Deployment[] // One infrastructure has many deployments
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  @@index([ownerId])
}


model Deployment {
  id                    String           @id        @default(uuid())
  infrastructureId      String
  infrastructure        Infrastructure   @relation(fields: [infrastructureId], references: [id], onDelete: Cascade) // Belongs to one infrastructure
  status                String                      @default("pending") // pending, running completed failed
  resourceCount         Int                         @default(0) // How many resources in this deployment
  stages                Json                        @default("[]") // Array of { timestamp, event, message }
  timeline              Json                        @default("[]") // Array of { timestamp, event, message }
  chaosEvents           Json                        @default("[]") // Chaos injection during deployment
  workloadProfile       Json?
  seed                  String?
  simulationState       Json?
  runInputs             Json?
  liveTopology          Json?
  topologyRevision      Int                         @default(0)
  runtimeActive         Boolean                     @default(false)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
}


// Basically a schema to keep track of atomicity of events. It's being used in deployment and chaos injection /currently. 
// i. In deployment it keeps track of either the deployment gets added to queue and mark completed at database or none happens...
// ii. In chaos-injection 
model Outbox {
  id                    String           @id        @default(uuid())
  eventType             String
  payload               Json
  status                String                      @default("pending") // pending -> processing -> completed -> failed
  retries               Int                         @default(0) // retries already done
  maxRetries            Int                         @default(4) // max allowed retries 
  processedAt           DateTime?
  error                 String?
  createdAt             DateTime                    @default(now())
}

model User {
  id            String @id
  name          String
  email         String @unique
  emailVerified Boolean @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sessions      Session[]
  accounts      Account[]
  designs       Infrastructure[]
}

model Session {
  id        String @id
  token     String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id                    String @id
  accountId             String
  providerId            String
  userId                String
  user                  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@index([userId])
  @@unique([providerId, accountId])
}

model Verification {
  id         String @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}
