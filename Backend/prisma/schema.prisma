generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Infrastructure {
  id                    String        @id           @default(uuid())
  userId                String                      @default("test-user")
  name                  String
  layout                Json
  deployments           Deployment[] // One infrastructure has many deployments
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
}

model Deployment {
  id                    String           @id        @default(uuid())
  infrastructureId      String
  infrastructure        Infrastructure   @relation(fields: [infrastructureId], references: [id], onDelete: Cascade) // Belongs to one infrastructure
  status                String                      @default("pending") // pending, running completed failed
  resourceCount         Int                         @default(0) // How many resources in this deployment
  stages                Json                        @default("[]") // Array of { timestamp, event, message }
  timeline              Json                        @default("[]") // Array of { timestamp, event, message }
  chaosEvents           Json                        @default("[]") // Chaos injection during deployment
  workloadProfile       Json?
  seed                  String?
  simulationState       Json?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
}


// Basically a schema to keep track of atomicity of events. It's being used in deployment and chaos injection /currently. 
// i. In deployment it keeps track of either the deployment gets added to queue and mark completed at database or none happens...
// ii. In chaos-injection 
model Outbox {
  id                    String           @id        @default(uuid())
  eventType             String
  payload               Json
  status                String                      @default("pending") // pending -> processing -> completed -> failed
  retries               Int                         @default(0) // retries already done
  // NOTE: worker.ts poller hardcodes retries < 4. Keep in sync if changing make changes at both places.
  maxRetries            Int                         @default(4) // max allowed retries 
  processedAt           DateTime?
  error                 String?
  createdAt             DateTime                    @default(now())
}