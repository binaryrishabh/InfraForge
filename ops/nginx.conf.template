# Install as a host Nginx server block. Replace DOMAIN and certificate paths.
# Only the TLS proxy is public. Compose API/WS ports must remain loopback-bound.
# This file is included in nginx's http context (as are server blocks).
limit_req_zone $binary_remote_addr zone=infraforge_health:1m rate=2r/s;
server {
    listen 80;
    # Auth links carry bearer tokens in paths/queries. Do not inherit request logs.
    access_log off;
    error_log /dev/null;
    server_name DOMAIN;
    location ^~ /.well-known/acme-challenge/ { root /var/lib/infraforge/acme; }
    location / { return 308 https://DOMAIN$request_uri; }
}
server {
    listen 443 ssl;
    access_log off;
    error_log /dev/null;
    server_name DOMAIN;
    ssl_certificate /etc/infraforge/tls/fullchain.pem;
    ssl_certificate_key /etc/infraforge/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    set $maintenance false;
    if (-f /var/lib/infraforge/releases/maintenance) { set $maintenance true; }
    add_header X-InfraForge-Maintenance $maintenance always;
    client_max_body_size 1m;

    location /api/ {
        if ($maintenance = true) { return 503; }
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host DOMAIN;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host DOMAIN;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
    }
    location = /ws {
        if ($maintenance = true) { return 503; }
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host DOMAIN;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host DOMAIN;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_read_timeout 75s;
    }
    location = /health/ready {
        limit_req zone=infraforge_health burst=4 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host DOMAIN;
    }
    location / { return 404; }
}
