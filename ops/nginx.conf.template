# Install as a host Nginx server block. Replace DOMAIN and certificate paths.
# Only the TLS proxy is public. Compose API/WS ports must remain loopback-bound.
server {
    listen 80;
    server_name DOMAIN;
    return 308 https://DOMAIN$request_uri;
}
server {
    listen 443 ssl;
    server_name DOMAIN;
    ssl_certificate /etc/infraforge/tls/fullchain.pem;
    ssl_certificate_key /etc/infraforge/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    set $maintenance false;
    if (-f /var/lib/infraforge/releases/maintenance) { set $maintenance true; }
    add_header X-InfraForge-Maintenance $maintenance always;
    client_max_body_size 1m;

    location /api/ {
        if ($maintenance = true) { return 503; }
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host DOMAIN;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host DOMAIN;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
    }
    location = /ws {
        if ($maintenance = true) { return 503; }
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host DOMAIN;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host DOMAIN;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_read_timeout 75s;
    }
    location = /health/ready {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host DOMAIN;
    }
    location / { return 404; }
}
