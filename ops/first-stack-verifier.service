[Unit]
Description=InfraForge trusted first-stack verifier
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/infraforge/verifier/settings.json

[Service]
Type=simple
User=infraforge-verifier
Group=infraforge-verifier
WorkingDirectory=/opt/infraforge/verifier-release
ExecStart=/usr/local/bin/bun --no-env-file --no-install apps/backend/executionIdentity/launcher.ts verifier
LoadCredential=database-url:/etc/infraforge/verifier/database-url
Environment=NODE_ENV=production REDIS_HOST=127.0.0.1 REDIS_PORT=6380
Restart=no
TimeoutStopSec=735
KillMode=mixed
MemoryMax=512M
MemorySwapMax=0
CPUQuota=15%
CPUQuotaPeriodSec=100ms
TasksMax=128
LimitNOFILE=512
NoNewPrivileges=yes
ProtectSystem=strict
# Hide home directories and expose only the selected dedicated daemon socket.
# Replace this UID when installing, using the same UID as settings.json.
ProtectHome=tmpfs
BindReadOnlyPaths=/run/user/REPLACE_WITH_UID/docker.sock
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077

# Intentionally no Install section: activation is a separate owner decision.
