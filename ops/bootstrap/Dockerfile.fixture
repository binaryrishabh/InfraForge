FROM oven/bun:1.3.14@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4 AS runtime
FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y nginx openssl curl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=runtime /usr/local/bin/bun /usr/local/bin/bun
COPY ops /fixture/ops
COPY ops/bootstrap/fixture.sh /fixture/prove.sh
CMD ["bash", "/fixture/prove.sh"]
