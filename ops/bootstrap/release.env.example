# Create privately as the release operator: /etc/infraforge/release.env, mode 0600.
# Replace every placeholder from the secret manager. Never source/print this file in CI.
DATABASE_URL=REQUIRED_NEON_POOLED_URL_WITH_VERIFY_FULL
MIGRATION_DATABASE_URL=REQUIRED_NEON_DIRECT_URL_WITH_VERIFY_FULL
WORKER_DATABASE_URL=REQUIRED_NEON_DIRECT_URL_WITH_VERIFY_FULL
WORKER_DATABASE_MODE=direct
BETTER_AUTH_SECRET=REQUIRED_STABLE_SECRET_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=https://backend.example.invalid
APP_ORIGINS=https://app.example.invalid
# Optional providers must supply both values, or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Account APIs and verification-required credential signup stay off until enabled.
ACCOUNT_ESSENTIALS_ENABLED=false
# ses or resend; a configured provider is required when enabling account APIs.
TRANSACTIONAL_EMAIL_PROVIDER=
TRANSACTIONAL_EMAIL_FROM=
RESEND_API_KEY=
# SES API credentials (not SMTP credentials), least privilege ses:SendEmail.
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_SESSION_TOKEN=
# Optional signup/reset protection. All three required if any is configured.
# Site key is public; secret key must remain backend-only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=
