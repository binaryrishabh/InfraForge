{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Optional legacy AWS-only backup/CloudWatch/SNS infrastructure. Not used by the R2 runner; do not deploy for the current backup installation.",
  "Parameters": {
    "HostRoleName": { "Type": "String", "AllowedPattern": "[A-Za-z0-9+=,.@_-]{1,64}" },
    "InstanceId": { "Type": "AWS::EC2::Instance::Id" },
    "AlertEmail": { "Type": "String", "AllowedPattern": "[^@\\s]+@[^@\\s]+\\.[^@\\s]+" }
  },
  "Resources": {
    "BackupBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "OwnershipControls": { "Rules": [{ "ObjectOwnership": "BucketOwnerEnforced" }] },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true, "BlockPublicPolicy": true, "IgnorePublicAcls": true, "RestrictPublicBuckets": true
        },
        "BucketEncryption": { "ServerSideEncryptionConfiguration": [{ "ServerSideEncryptionByDefault": { "SSEAlgorithm": "AES256" } }] },
        "VersioningConfiguration": { "Status": "Enabled" },
        "LifecycleConfiguration": { "Rules": [
          { "Id": "DailyFourWeeks", "Status": "Enabled", "Prefix": "backups/daily/", "ExpirationInDays": 28, "NoncurrentVersionExpiration": { "NoncurrentDays": 1 } },
          { "Id": "WeeklyFourWeeks", "Status": "Enabled", "Prefix": "backups/weekly/", "ExpirationInDays": 28, "NoncurrentVersionExpiration": { "NoncurrentDays": 1 } },
          { "Id": "RemoveExpiredMarkers", "Status": "Enabled", "Prefix": "backups/", "ExpiredObjectDeleteMarker": true, "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 1 } }
        ] }
      }
    },
    "BackupBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": { "Ref": "BackupBucket" },
        "PolicyDocument": { "Version": "2012-10-17", "Statement": [
          { "Sid": "TLSOnly", "Effect": "Deny", "Principal": "*", "Action": "s3:*", "Resource": [{ "Fn::GetAtt": ["BackupBucket", "Arn"] }, { "Fn::Sub": "${BackupBucket.Arn}/*" }], "Condition": { "Bool": { "aws:SecureTransport": "false" } } },
          { "Sid": "RequireSSES3", "Effect": "Deny", "Principal": "*", "Action": "s3:PutObject", "Resource": { "Fn::Sub": "${BackupBucket.Arn}/backups/*" }, "Condition": { "StringNotEquals": { "s3:x-amz-server-side-encryption": "AES256" } } }
        ] }
      }
    },
    "HostPolicy": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": { "Fn::Sub": "${AWS::StackName}-backup-alerts" },
        "Roles": [{ "Ref": "HostRoleName" }],
        "PolicyDocument": { "Version": "2012-10-17", "Statement": [
          { "Sid": "UploadOnly", "Effect": "Allow", "Action": "s3:PutObject", "Resource": [{ "Fn::Sub": "${BackupBucket.Arn}/backups/daily/*" }, { "Fn::Sub": "${BackupBucket.Arn}/backups/weekly/*" }] },
          { "Sid": "PublishOnlyOpsMetrics", "Effect": "Allow", "Action": "cloudwatch:PutMetricData", "Resource": "*", "Condition": { "StringEquals": { "cloudwatch:namespace": "InfraForge/Ops" } } }
        ] }
      }
    },
    "Alerts": { "Type": "AWS::SNS::Topic" },
    "Email": { "Type": "AWS::SNS::Subscription", "Properties": { "TopicArn": { "Ref": "Alerts" }, "Protocol": "email", "Endpoint": { "Ref": "AlertEmail" } } },
    "AlertPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Properties": {
        "Topics": [{ "Ref": "Alerts" }],
        "PolicyDocument": { "Version": "2012-10-17", "Statement": [{
          "Effect": "Allow", "Principal": { "Service": "cloudwatch.amazonaws.com" }, "Action": "sns:Publish", "Resource": { "Ref": "Alerts" },
          "Condition": { "StringEquals": { "aws:SourceAccount": { "Ref": "AWS::AccountId" } }, "ArnLike": { "aws:SourceArn": { "Fn::Sub": "arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:*" } } }
        }] }
      }
    },
    "SiteAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Site HTTPS check failed, or host publisher absent for three minutes",
        "Namespace": "InfraForge/Ops", "MetricName": "SiteReady", "Dimensions": [{ "Name": "InstanceId", "Value": { "Ref": "InstanceId" } }],
        "Statistic": "Minimum", "Period": 60, "EvaluationPeriods": 3, "DatapointsToAlarm": 3, "Threshold": 1, "ComparisonOperator": "LessThanThreshold", "TreatMissingData": "breaching", "AlarmActions": [{ "Ref": "Alerts" }], "OKActions": [{ "Ref": "Alerts" }]
      }
    },
    "ApiAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "API public HTTPS readiness check failed or monitoring absent",
        "Namespace": "InfraForge/Ops", "MetricName": "ApiReady", "Dimensions": [{ "Name": "InstanceId", "Value": { "Ref": "InstanceId" } }],
        "Statistic": "Minimum", "Period": 60, "EvaluationPeriods": 3, "DatapointsToAlarm": 3, "Threshold": 1, "ComparisonOperator": "LessThanThreshold", "TreatMissingData": "breaching", "AlarmActions": [{ "Ref": "Alerts" }], "OKActions": [{ "Ref": "Alerts" }]
      }
    },
    "WorkerAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Worker readiness (including outbox success within 15 seconds) failed or monitoring absent",
        "Namespace": "InfraForge/Ops", "MetricName": "WorkerReady", "Dimensions": [{ "Name": "InstanceId", "Value": { "Ref": "InstanceId" } }],
        "Statistic": "Minimum", "Period": 60, "EvaluationPeriods": 3, "DatapointsToAlarm": 3, "Threshold": 1, "ComparisonOperator": "LessThanThreshold", "TreatMissingData": "breaching", "AlarmActions": [{ "Ref": "Alerts" }], "OKActions": [{ "Ref": "Alerts" }]
      }
    },
    "DiskAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Maximum root, backup or Docker filesystem usage above 80 percent or monitoring absent",
        "Namespace": "InfraForge/Ops", "MetricName": "DiskUsedPercent", "Dimensions": [{ "Name": "InstanceId", "Value": { "Ref": "InstanceId" } }],
        "Statistic": "Maximum", "Period": 60, "EvaluationPeriods": 5, "DatapointsToAlarm": 5, "Threshold": 80, "ComparisonOperator": "GreaterThanThreshold", "TreatMissingData": "breaching", "AlarmActions": [{ "Ref": "Alerts" }], "OKActions": [{ "Ref": "Alerts" }]
      }
    },
    "MemoryAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Host memory usage above 85 percent for five minutes or monitoring absent",
        "Namespace": "InfraForge/Ops", "MetricName": "MemoryUsedPercent", "Dimensions": [{ "Name": "InstanceId", "Value": { "Ref": "InstanceId" } }],
        "Statistic": "Maximum", "Period": 60, "EvaluationPeriods": 5, "DatapointsToAlarm": 5, "Threshold": 85, "ComparisonOperator": "GreaterThanThreshold", "TreatMissingData": "breaching", "AlarmActions": [{ "Ref": "Alerts" }], "OKActions": [{ "Ref": "Alerts" }]
      }
    },
    "BackupAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Last successfully uploaded snapshot is older than 26 hours, unknown, or monitoring absent",
        "Namespace": "InfraForge/Ops", "MetricName": "BackupAgeSeconds", "Dimensions": [{ "Name": "InstanceId", "Value": { "Ref": "InstanceId" } }],
        "Statistic": "Maximum", "Period": 60, "EvaluationPeriods": 2, "DatapointsToAlarm": 2, "Threshold": 93600, "ComparisonOperator": "GreaterThanThreshold", "TreatMissingData": "breaching", "AlarmActions": [{ "Ref": "Alerts" }], "OKActions": [{ "Ref": "Alerts" }]
      }
    },
    "DrillAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Restore drill failed/interrupted, never passed, older than 35 days, or monitoring absent",
        "Namespace": "InfraForge/Ops", "MetricName": "RestoreDrillHealthy", "Dimensions": [{ "Name": "InstanceId", "Value": { "Ref": "InstanceId" } }],
        "Statistic": "Minimum", "Period": 60, "EvaluationPeriods": 2, "DatapointsToAlarm": 2, "Threshold": 1, "ComparisonOperator": "LessThanThreshold", "TreatMissingData": "breaching", "AlarmActions": [{ "Ref": "Alerts" }], "OKActions": [{ "Ref": "Alerts" }]
      }
    }
  },
  "Outputs": {
    "BucketName": { "Value": { "Ref": "BackupBucket" } },
    "TopicArn": { "Value": { "Ref": "Alerts" } },
    "Region": { "Value": { "Ref": "AWS::Region" } }
  }
}
