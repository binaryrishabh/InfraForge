[Unit]
Description=InfraForge readiness, host capacity and backup health metrics
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
UMask=0077
StateDirectory=infraforge-ops
StateDirectoryMode=0700
ExecStart=/bin/bash /opt/infraforge-ops/backup-alerts/run.sh metrics
TimeoutStartSec=55s
TimeoutStopSec=5s
KillMode=control-group
Nice=10
MemoryMax=128M
TasksMax=32
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/infraforge-ops
ProtectHome=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=infraforge-ops-metrics
