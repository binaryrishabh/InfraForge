# Keep the build context limited to the current backend workspace inputs.
**

!package.json
!bun.lock
!bunfig.toml
!tsconfig.base.json
!turbo.json

# A parent inclusion admits children; exclude its subtree before allowing files.
!Frontend/
Frontend/**
!Frontend/package.json
!Backend/
Backend/**
!Backend/package.json
!Backend/Dockerfile
!Backend/index.ts
!Backend/worker.ts
!Backend/ws-server.ts
!Backend/tsconfig.json
!Backend/prisma.config.ts

!Backend/infra/
Backend/infra/**
!Backend/infra/*.ts
!Backend/lib/
Backend/lib/**
!Backend/lib/prisma.ts
!Backend/routes/
Backend/routes/**
!Backend/routes/*.ts
!Backend/simulator/
Backend/simulator/**
!Backend/simulator/*.ts
!Backend/stages/
Backend/stages/**
!Backend/stages/*.ts
!Backend/utils/
Backend/utils/**
!Backend/utils/*.ts
!Backend/zod_schemas/
Backend/zod_schemas/**
!Backend/zod_schemas/*.ts

!Backend/prisma/
Backend/prisma/**
!Backend/prisma/schema.prisma
!Backend/prisma/migrations/
Backend/prisma/migrations/**
!Backend/prisma/migrations/migration_lock.toml
!Backend/prisma/migrations/*/
Backend/prisma/migrations/*/**
!Backend/prisma/migrations/*/migration.sql

!shared/
shared/**
!shared/*/
shared/*/**
!shared/*/*.ts

# Final exclusions also apply inside allowed source directories.
**/.*
**/.*/**
**/*.env
**/*.env.*
**/node_modules
**/node_modules/**
**/generated
**/generated/**
**/dist
**/dist/**
**/coverage
**/coverage/**
**/cache
**/cache/**
**/*.tsbuildinfo
**/AGENTS.md
**/SKILL.md
**/skills-lock.json
